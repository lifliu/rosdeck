#!/usr/bin/env bash
set -e

source "@ROS_SETUP@"
if [[ -f "@INSTALL_PREFIX@/runtime/local_setup.bash" ]]; then
  source "@INSTALL_PREFIX@/runtime/local_setup.bash"
fi
export LD_LIBRARY_PATH="@INSTALL_PREFIX@/runtime/lib:${LD_LIBRARY_PATH:-}"

# The process can start before the Zsibot network is ready because initRobot()
# is now lazy.  Each acquire request validates that the configured local IP is
# assigned before constructing the vendor SDK, so a failed early request can be
# retried without restarting this service.

exec "@INSTALL_PREFIX@/bin/rosdeck_robot_bridge_node" \
  --ros-args -r __node:=@NODE_NAME@ \
  --params-file "@INSTALL_PREFIX@/config/bridge.yaml"
