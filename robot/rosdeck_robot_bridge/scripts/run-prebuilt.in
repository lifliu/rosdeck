#!/usr/bin/env bash
set -e

source "@ROS_SETUP@"
if [[ -f "@CURRENT@/runtime/local_setup.bash" ]]; then
  source "@CURRENT@/runtime/local_setup.bash"
fi
export LD_LIBRARY_PATH="@CURRENT@/runtime/lib:${LD_LIBRARY_PATH:-}"

PROFILE="@PROFILE@"
ENABLE_SAFETY_SUPERVISOR=false
if [[ "${PROFILE}" == "zsibot" ]]; then
  "@CURRENT@/runtime/lib/rosdeck_robot_bridge/assert-no-legacy-zsibot-owner.sh"
  ENABLE_SAFETY_SUPERVISOR=true
fi

# The process can start before the Zsibot network is ready because initRobot()
# is now lazy.  Each acquire request validates that the configured local IP is
# assigned before constructing the vendor SDK, so a failed early request can be
# retried without restarting this service.

exec ros2 launch rosdeck_robot_bridge product_bringup.launch.py \
  config:="@CURRENT@/config/bridge.yaml" \
  bridge_node_name:=@NODE_NAME@ \
  enable_safety_supervisor:="${ENABLE_SAFETY_SUPERVISOR}"