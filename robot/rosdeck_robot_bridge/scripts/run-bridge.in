#!/usr/bin/env bash
set -e

source "@ROS_SETUP@"
source "@INSTALL_PREFIX@/install/setup.bash"

PROFILE="@PROFILE@"
ENABLE_SAFETY_SUPERVISOR=false
if [[ "${PROFILE}" == "zsibot" ]]; then
  "@INSTALL_PREFIX@/install/lib/rosdeck_robot_bridge/assert-no-legacy-zsibot-owner.sh"
  ENABLE_SAFETY_SUPERVISOR=true
fi

exec ros2 launch rosdeck_robot_bridge product_bringup.launch.py \
  config:="@INSTALL_PREFIX@/config/bridge.yaml" \
  bridge_node_name:=@NODE_NAME@ \
  enable_safety_supervisor:="${ENABLE_SAFETY_SUPERVISOR}"
