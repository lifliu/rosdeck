[Unit]
Description=Omni WS gateway (TLS + login + RBAC in front of foxglove_bridge)
Wants=network-online.target rosdeck-foxglove-bridge.service
After=network-online.target rosdeck-foxglove-bridge.service

[Service]
Type=simple
User=rosdeck
Group=rosdeck
# OMNI_WS_*: the gateway is ROS-independent; fixed product paths, no
# EnvironmentFile. It serves wss on 8765 and forwards to loopback 8766.
Environment=OMNI_WS_LISTEN=0.0.0.0:8765
Environment=OMNI_WS_UPSTREAM=127.0.0.1:8766
Environment=OMNI_WS_TLS_DIR=/var/lib/omni/tls
Environment=OMNI_WS_AUTH_DIR=/var/lib/omni/auth
Environment=OMNI_WS_AUDIT_DIR=/var/lib/omni/audit
ExecStartPre=+mkdir -p /var/lib/omni/tls /var/lib/omni/auth /var/lib/omni/audit
ExecStart=@INSTALL_PREFIX@/bin/run-omni-ws-gateway
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
# Hardening: matches the rosdeck-foxglove-bridge / mission-manager profile.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=
LockPersonality=yes
CapabilityBoundingSet=
StateDirectory=omni
TasksMax=512
MemoryHigh=256M
MemoryMax=512M
CPUQuota=200%
IOWeight=50

[Install]
WantedBy=multi-user.target